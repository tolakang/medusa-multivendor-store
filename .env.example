# =============================================================================
# Medusa Multi-Vendor Store - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your deployment.
# In Dokploy, set these as environment variables in the service configuration.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=medusa_store

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Meilisearch ----
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=CHANGE_ME_master_key_here

# ---- Medusa Server ----
MEDUSA_PORT=9000
JWT_SECRET=CHANGE_ME_random_string_32_chars
COOKIE_SECRET=CHANGE_ME_random_string_32_chars

# WORKER_MODE: server (API + scheduled jobs) | worker (background jobs only) | shared
WORKER_MODE=server

# ADMIN_DISABLED: true for worker, false for server
ADMIN_DISABLED=false

# ---- CORS Settings ----
# Replace localhost with your actual domains when deploying
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ---- Storefront ----
STOREFRONT_PORT=8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://medusa-server:9000
STORE_NAME=Medusa Multi-Vendor Store
