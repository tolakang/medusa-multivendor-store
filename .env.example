# =============================================================================
# Medusa Multi-Vendor Store — Environment Variables
# =============================================================================
# For individual service deployment, set HOST variables to match your
# Dokploy service names (e.g., medusa-infra-postgres, medusa-infra-redis).
#
# ⚠️  FIRST: Run `bash scripts/generate-lockfile.sh` on your server
#     to create pnpm-lock.yaml files. This prevents npm 429 errors.
# =============================================================================

# ---- NPM Authentication (RECOMMENDED — Prevents 429 Rate Limits) ----
# Authenticated npm requests get 50x higher rate limits than anonymous.
# Get your token: https://www.npmjs.com/settings/tokens → Create New Token → Automation
# Set this in Dokploy as a build variable (NOT a runtime env var).
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- PostgreSQL ----
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=medusa_store
POSTGRES_HOST=postgres              # Docker service name or Dokploy hostname
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis                    # Docker service name or Dokploy hostname
REDIS_PORT=6379

# ---- Meilisearch ----
MEILISEARCH_HOST=meilisearch        # Docker service name or Dokploy hostname
MEILISEARCH_PORT=7700
MEILISEARCH_ADMIN_KEY=CHANGE_ME_master_key_here

# ---- Medusa Server ----
MEDUSA_PORT=9000
JWT_SECRET=CHANGE_ME_random_string_32_chars
COOKIE_SECRET=CHANGE_ME_random_string_32_chars
BACKEND_URL=http://localhost:9000

# MEDUSA_WORKER_MODE: server (API + scheduled jobs) | worker (background jobs) | shared
MEDUSA_WORKER_MODE=server

# MEDUSA_DISABLE_ADMIN: true for worker, false for server
MEDUSA_DISABLE_ADMIN=false

# ---- CORS Settings ----
# Replace localhost with your actual domains when deploying
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ---- Storefront ----
STOREFRONT_PORT=8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
