# ===========================================
# Medusa 2.0 Multi-Vendor Store - Environment
# ===========================================
# Copy this file to .env and update the values

# Database
POSTGRES_USER=medusa
POSTGRES_DB=medusa_store
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Medusa Backend
JWT_SECRET=change-me-to-a-secure-jwt-secret
COOKIE_SECRET=change-me-to-a-secure-cookie-secret
DISABLE_MEDUSA_ADMIN=false

# CORS - Update with your actual domains
STORE_CORS=https://store.yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com
AUTH_CORS=https://store.yourdomain.com,https://admin.yourdomain.com

# Meilisearch
MEILISEARCH_MASTER_KEY=change-me-to-a-secure-meilisearch-key

# Storefront
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.yourdomain.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your-publishable-key
