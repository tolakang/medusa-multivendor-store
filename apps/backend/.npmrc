# npm/pnpm configuration for rate-limit avoidance (Oracle Cloud, etc.)
registry=https://registry.npmjs.org/
fetch-retries=10
fetch-retry-mintimeout=120000
fetch-retry-maxtimeout=600000
fetch-retry-factor=2
network-concurrency=4
prefer-offline=true
# Uncomment the line below and set NPM_TOKEN in your environment for authenticated builds.
# Authenticated requests get 50x higher rate limits than anonymous.
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
