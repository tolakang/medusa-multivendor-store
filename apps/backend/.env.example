NODE_ENV=production

# Database
DATABASE_URL=postgres://medusa:change-me@postgres:5432/medusa-store

# Redis
REDIS_URL=redis://redis:6379

# Medusa
PORT=9000
JWT_SECRET=change-me-to-a-secure-random-string
COOKIE_SECRET=change-me-to-a-secure-random-string
MEDUSA_WORKER_MODE=server
DISABLE_MEDUSA_ADMIN=false

# CORS (update with your actual domains)
# Use your actual domain names in production, not localhost
# Examples:
#   STORE_CORS=https://store.yourdomain.com
#   ADMIN_CORS=https://admin.yourdomain.com
#   AUTH_CORS=https://store.yourdomain.com,https://admin.yourdomain.com
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change-me-to-a-secure-random-string
