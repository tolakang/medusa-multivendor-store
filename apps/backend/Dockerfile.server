# =============================================================================
# Medusa 2.0 Server — API + Admin + Scheduled Jobs
# Optimized for rate-limited environments (Oracle Cloud, etc.)
# =============================================================================
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

# ---- Phase 1: Install dependencies (cached via BuildKit) ----
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json .npmrc pnpm-lock.yaml* ./
# Install dependencies with aggressive retry for rate-limited environments
# --prefer-offline: use local cache before hitting registry
# --no-frozen-lockfile: generate lockfile if missing
# --network-concurrency=2: reduce concurrent requests to avoid 429
# Cache mounts persist pnpm store across builds (first build: 10-15min, cached: 30-60s)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/root/.npm \
    (pnpm install \
      --no-frozen-lockfile \
      --prefer-offline \
      --fetch-retries=10 \
      --fetch-retry-mintimeout=120000 \
      --fetch-retry-maxtimeout=600000 \
      --network-concurrency=2 \
    || (echo "First attempt failed, waiting 120s before retry..." && \
        sleep 120 && \
        pnpm install \
          --no-frozen-lockfile \
          --prefer-offline \
          --fetch-retries=10 \
          --fetch-retry-mintimeout=120000 \
          --fetch-retry-maxtimeout=600000 \
          --network-concurrency=2))

# ---- Phase 2: Build application ----
FROM base AS builder
WORKDIR /app
ENV NODE_ENV=development
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm run build

# ---- Phase 3: Production runner ----
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache curl netcat-openbsd
RUN corepack enable
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 medusa
COPY --from=builder /app/.medusa/server ./
COPY --from=builder /app/src/scripts/start-server.sh ./start-server.sh
RUN chmod +x ./start-server.sh && chown -R medusa:nodejs /app
USER medusa
EXPOSE 9000
ENV PORT=9000
CMD ["./start-server.sh"]
