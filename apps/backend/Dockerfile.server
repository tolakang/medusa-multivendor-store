# =============================================================================
# Medusa 2.0 Server — API + Admin + Scheduled Jobs
# Uses pre-built base image if available, otherwise builds deps inline
# =============================================================================
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

# ---- Phase 1: Install dependencies (cached via BuildKit) ----
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
# Docker BuildKit caches the pnpm store at /root/.local/share/pnpm/store
# First build: 10-15 min. Subsequent builds: 30-60s (cache hit).
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install \
      --no-frozen-lockfile \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=60000 \
      --fetch-retry-maxtimeout=120000 \
      --network-concurrency=4

# ---- Phase 2: Build application ----
FROM base AS builder
WORKDIR /app
ENV NODE_ENV=development
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm run build

# ---- Phase 3: Production runner ----
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache curl netcat-openbsd
RUN corepack enable
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 medusa
COPY --from=builder /app/.medusa/server ./
COPY --from=builder /app/src/scripts/start-server.sh ./start-server.sh
RUN chmod +x ./start-server.sh && chown -R medusa:nodejs /app
USER medusa
EXPOSE 9000
ENV PORT=9000
CMD ["./start-server.sh"]
